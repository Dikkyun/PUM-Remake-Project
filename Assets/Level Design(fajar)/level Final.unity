  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 149
  indentLevel: 0
  storyText: "The worst part, her classmates actually know about this. But they just
    turned a blind eye because they don\u2019t want to get involved with those stupid
    kids."
